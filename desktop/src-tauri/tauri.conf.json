{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reseau",
  "version": "1.0.0",
  "identifier": "fr.skhost.reseau",
  "build": {
    "frontendDist": "https://compagnie.skhost.fr"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Skylaize",
    "shortDescription": "Réseau, jeu de gestion ferroviaire",
    "longDescription": "Réseau, le jeu de gestion ferroviaire, dans sa propre fenêtre, avec votre partie affichée sur votre profil Discord.",
    "copyright": "© 2026 Skylaize",
    "category": "SimulationGame",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false
      }
    }
  }
}
